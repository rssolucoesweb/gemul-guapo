<%
function sqlAlunoTurma(turma, disc)		
	'**** SELECIONA OS ALUNOS REGULARES
	sql = " SELECT SCA_ALUNO_DISCIPLINA.CODIGO AS COD_ALUNO_DISCIPLINA, " 
 	sql = sql & " SCA_ALUNO_DISCIPLINA.COD_ALUNO AS CODIGO, "
 	sql = sql & " SCA_ALUNO_DISCIPLINA.COD_TURMA_REMANEJAMENTO AS COD_TURMA, "
 	sql = sql & " SCA_ALUNO_DISCIPLINA.COD_DISCIPLINA, "
    sql = sql & " SCA_SITUACAOALUNO.Desc_SituacaoAluno, "	
 	sql = sql & " SCA_ALUNO.NOMEALUNO, "
    sql = sql & " ' ' as sequencia, "
 	sql = sql & " SCA_ALUNO.MATRICULA, "
 	sql = sql & " SCA_GRADECURRICULAR.COD_PERIODO "
 	sql = sql & " FROM SCA_ALUNO_DISCIPLINA INNER JOIN "
	sql = sql & " SCA_ALUNO ON SCA_ALUNO.CODIGO = SCA_ALUNO_DISCIPLINA.COD_ALUNO INNER JOIN "
	sql = sql & " SCA_TURMA ON SCA_TURMA.COD_TURMA = SCA_ALUNO_DISCIPLINA.COD_TURMA_REMANEJAMENTO and SCA_TURMA.cod_empresa = sca_aluno.cod_empresa INNER JOIN "
	sql = sql & " SCA_GRADECURRICULARDISCIPLINA ON SCA_GRADECURRICULARDISCIPLINA.Cod_GradeCurriculardisciplina = SCA_ALUNO_DISCIPLINA.Cod_GradeCurricularDisciplina INNER JOIN "
	sql = sql & " SCA_GRADECURRICULAR ON SCA_GRADECURRICULAR.Cod_GradeCurricular = SCA_GRADECURRICULARDISCIPLINA.Cod_GradeCurricular INNER JOIN "
	sql = sql & " SCA_NOTAS_FALTAS ON SCA_NOTAS_FALTAS.cod_aluno = SCA_ALUNO.CODIGO AND SCA_NOTAS_FALTAS.cod_empresa = SCA_ALUNO_DISCIPLINA.COD_EMPRESA AND SCA_NOTAS_FALTAS.cod_disciplina = SCA_ALUNO_DISCIPLINA.COD_DISCIPLINA AND SCA_NOTAS_FALTAS.cod_aluno_disciplina = SCA_ALUNO_DISCIPLINA.CODIGO INNER JOIN "
	sql= sql  & " SCA_SITUACAOALUNO ON SCA_SITUACAOALUNO.Cod_SituacaoAluno = SCA_ALUNO.COD_SITUACAOALUNO and SCA_SITUACAOALUNO.cod_empresa = SCA_ALUNO.cod_empresa "
	sql = sql & " WHERE SCA_ALUNO_DISCIPLINA.COD_DISCIPLINA = " & disc 
	sql = sql & " AND SCA_ALUNO_DISCIPLINA.COD_TURMA_REMANEJAMENTO = " & turma
	sql = sql & " AND SCA_ALUNO_DISCIPLINA.COD_EMPRESA = " & Session("CodEmpresa")
	sql = sql & " AND SCA_SITUACAOALUNO.Desc_SituacaoAluno = 'ATIVO' " 
	sql = sql & " ORDER BY SCA_ALUNO.NOMEALUNO "
    sqlAlunoTurma = sql
end function
%>
