# Configurações com senha (o original continua no seu PC, só não sobe)
# Todos os arquivos de conexão, em qualquer pasta
*inc_cnn*.asp
# Mas as cópias de exemplo podem subir
!*.exemplo.asp

# Backup de configuração
web_Original.config

global.asa

# Uploads, logs e temporários
uploads/
upload/
arquivos/
logs/
*.log
*.tmp

