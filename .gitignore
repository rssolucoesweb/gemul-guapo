*.mdb
*.accdb
*.bak
*.sql.bak
*.zip
*.rar

# Sistema
Thumbs.db
desktop.ini

# Vídeos (tutoriais) — grandes demais para o GitHub
*.mp4
*.avi
*.mov
*.wmv
*.mkv

# Versão antiga, fora de uso
gemul2015/

