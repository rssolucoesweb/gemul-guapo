includes/inc_apontamento_remove.asp
sistema/EST/Rel_ComparativoProduto_rel.asp
sistema/SEG/Empresa_cod.asp
# Credenciais (ficam só no servidor)
*inc_serasa_config.asp
*inc_whatsapp_config.asp

